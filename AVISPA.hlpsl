role role_UA(UA:agent,TA:agent,UB:agent,Key_set_UA_TA:(symmetric_key) set,Key_set_TA_UA:(symmetric_key) set,SND,RCV:channel(dy))
played_by UA
def=
	local
		State:nat,H,ECC:hash_func,GPWa:text,HIDa:text,Xa:text,DDa:text,T1:text,Ta:text,Ma:text,PIDa:text,Za:text,Ramask:text,T2:text,Tb:text,Mb:text,PIDb:text,Zb:text,Rbmask:text,Key_2:symmetric_key,Key_1:symmetric_key
	init
		State := 0
	transition
		
1. State=0 /\ RCV(start) =|> State':=1 
/\ NNa':=new()
/\ XXa':=new() 
/\ Xa':=ECC(XXa',GG)
/\ HIDa':=h(IDa,NNa') 
/\ HPWa':=h(PWa,NNa') 
/\ GPWa':=xor(HPWa',NNi')
/\ Key_1':=new() 
/\ Key_set_UA_TA':=cons(Key_1',Key_set_UA_TA) 
/\ SND({HIDa'.Xa'.GPWa'}_Key_1')
		
2. State=1 /\ in(Key_2',Key_set_TA_UA) 
/\ RCV({DDa'}_Key_2') =|> State':=2 
/\ Key_set_TA_UA':=delete(Key_2',Key_set_TA_UA) 
/\ Va':=h(IDa,HPWa,NNa)
/\ Na':= xor(NNa',h(PWa,IDa))
/\ Aa':= xor(XXa,HPWa)
/\ Ba':= xor(DDa',NNa)

/\ RRa':=new() 
/\ UUa':=new() 
/\ T1':=new() 
/\ Ma':=ECC(RRa',GG)
/\ Ta':=ECC(UUa',GG)
/\ XXa':=xor(Aa',HPWa)
/\ Sigmaa':=xor(Ba',HPWa)
/\ Kab':=h(ECC(RRa',Xb),T1')
/\ Autha':=h(IDa,IDb,Ma',Kab',RRa',T1')
/\ ZZa':=ECC(UUa',Autha',Sigmaa')
/\ Ramask':=xor(RRa',h(Kab',T1))
/\ PIDa':=xor(IDa,h(Kab',RRa',T1'))
/\ secret(Ramask',sec_1,{UA,UB}) 
/\ SND(PIDa'.Ma'.Za'.Ta'.Ramask'.T1')
		
4. State=2 /\ RCV(PIDb'.Mb'.Zb'.Tb'.Rbmask'.T2') =|> State':=3 
/\ secret(Rbmask',sec_2,{UA,UB})
/\ Kba':=h(ECC(XXa,Mb'),T2')
/\ RRb':= xor(Rbmmask,h(Kba',T2'))
/\ IDb':=xor(PIDb',h(Kba',RRb',T2'))
/\ Authb':=h(IDa,IDb',Mb',Kba',RRb',T2')
/\ ZZb':= h(Tb',Authb',Wb)
/\ SK':=h(IDa,IDb',ECC(RRb',MA),Kab',Kba',T1,T2')

end role

role role_UB(UA:agent,TA:agent,UB:agent,Key_set_UB_TA:(symmetric_key) set,Key_set_TA_UB:(symmetric_key) set,SND,RCV:channel(dy))
played_by UB
def=
	local
		State:nat,GPWb:text,H:hash_func,HIDb:text,Xb:text,DDb:text,T1:text,Ta:text,Ma:text,PIDa:text,Za:text,Ramask:text,T2:text,Tb:text,Mb:text,PIDb:text,Zb:text,Rbmask:text,Key_2:symmetric_key,Key_1:symmetric_key
	init
		State := 0
	transition
		
1. State=0 /\ RCV(start) =|> State':=1 
/\ NNb':=new()
/\ XXb':=new() 
/\ Xb':=ECC(XXb',GG)
/\ HIDb':=h(IDb,NNb') 
/\ HPWb':=h(PWb,NNb') 
/\ GPWb':=xor(HPWb',NNb')
/\ Key_1':=new() 
/\ Key_set_UB_TA':=cons(Key_1',Key_set_UB_TA) 
/\ SND({HIDb'.Xb'.GPWb'}_Key_1')

2. State=1 /\ in(Key_2',Key_set_TA_UB) /\ RCV({DDb'}_Key_2') =|> State':=2 
/\ Key_set_TA_UB':=delete(Key_2',Key_set_TA_UB)
/\ Vb':=h(IDb,HPWb,NNb)
/\ Nb':= xor(NNb',h(PWb,IDb))
/\ Ab':= xor(XXb,HPWb)
/\ Bb':= xor(DDb',NNb)

		
3. State=2 /\ RCV(PIDa'.Ma'.Za'.Ta'.Ramask'.T1') =|> State':=3 
/\ secret(Ramask',sec_1,{UA,UB}) 
/\ witness(UB,UA,auth_4,Za') 
/\ XXb':=xor(Ab,HPWb)
/\ Sigmab':=xor(Bb,HPWb)
/\ Kab':=h(ECC(XXb',Ma'),T1')
/\ RRa':= xor(Ramask',h(Kab',T1'))
/\ IDa'':=xor(PIDa',h(Kab',RRa',T1'))
/\ Autha':=h(IDa',IDb,Ma',Kab',RRa',T1')
/\ ZZa':=ECC(Ta',Autha',Wa)

/\ RRb':= new() 
/\ UUb':= new()
/\ T2':=new() 
/\ Mb':=ECC(RRb',GG)
/\ Tb':=ECC(UUb',GG)
/\ Kba':= h(ECC(RRb',Xa),T2')
/\ PIDb':= xor(IDb,h(Kba',RRb',T2'))
/\ Zb':=ECC(UUb',Authb',Sigmab')
/\ Rbmask':=xor(RRb',h(Kba',T2'))
/\ SK':= h(IDa',IDb,ECC(RRb',Ma'),Kab',Kba',T1',T2')
/\ secret(Rbmask',sec_2,{UA,UB})  
/\ SND(PIDb'.Mb'.Zb'.Tb'.Rbmask'.T2')
end role


role role_TA(UA:agent,TA:agent,UB:agent,Key_set_UA_TA:(symmetric_key) set,Key_set_TA_UA:(symmetric_key) set,Key_set_UB_TA:(symmetric_key) set,Key_set_TA_UB:(symmetric_key) set,SND,RCV:channel(dy))
played_by TA
def=
	local
		State:nat,GPWa:text,H,ECC:hash_func,HIDa:text,Xa:text,DDa:text,GPWb:text,HIDb:text,Xb:text,DDb:text,Key_4:symmetric_key,Key_3:symmetric_key,Key_2:symmetric_key,Key_1:symmetric_key
	init
		State := 0
	transition
		
1. State=0 /\ in(Key_1',Key_set_UA_TA) 
/\ RCV({HIDa'.Xa'.GPWa'}_Key_1') =|> State':=1 
/\ Key_set_UA_TA':=delete(Key_1',Key_set_UA_TA) 
/\ Sigmaa':=h(HIDa',SS,Xa')
/\ DDa':=xor(Sigmaa',GPWa')
/\ Wa':=ECC(Sigmaa',GG)
/\ Key_2':=new() 
/\ Key_set_TA_UA':=cons(Key_2',Key_set_TA_UA) 
/\ SND({DDa'}_Key_2')
		
1. State=1 /\ in(Key_3',Key_set_UB_TA) 
/\ RCV({HIDb'.Xb'.GPWb'}_Key_3') =|> State':=2 
/\ Key_set_UB_TA':=delete(Key_3',Key_set_UB_TA) 
/\ Sigmab':=h(HIDb',SS,Xb')
/\ DDb':=xor(Sigmab',GPWb')
/\ Wb':=ECC(Sigmab',GG)
/\ Key_4':=new() 
/\ Key_set_TA_UB':=cons(Key_4',Key_set_TA_UB) 
/\ SND({DDb'}_Key_4')
end role


role session1(UA:agent,TA:agent,UB:agent,Key_set_TA_UA:(symmetric_key) set,Key_set_UA_TA:(symmetric_key) set,Key_set_UB_TA:(symmetric_key) set,Key_set_TA_UB:(symmetric_key) set)
def=
	local
		SND3,RCV3,SND2,RCV2,SND1,RCV1:channel(dy)
	composition
		role_UB(UA,TA,UB,Key_set_UB_TA,Key_set_TA_UB,SND3,RCV3) /\ role_TA(UA,TA,UB,Key_set_UA_TA,Key_set_TA_UA,Key_set_UB_TA,Key_set_TA_UB,SND2,RCV2) /\ role_UA(UA,TA,UB,Key_set_UA_TA,Key_set_TA_UA,SND1,RCV1)
end role

role session2(UA:agent,TA:agent,UB:agent,Key_set_TA_UA:(symmetric_key) set,Key_set_UA_TA:(symmetric_key) set,Key_set_UB_TA:(symmetric_key) set,Key_set_TA_UB:(symmetric_key) set)
def=
	local
		SND3,RCV3,SND2,RCV2,SND1,RCV1:channel(dy)
	composition
		role_UB(UA,TA,UB,Key_set_UB_TA,Key_set_TA_UB,SND3,RCV3) /\ role_TA(UA,TA,UB,Key_set_UA_TA,Key_set_TA_UA,Key_set_UB_TA,Key_set_TA_UB,SND2,RCV2) /\ role_UA(UA,TA,UB,Key_set_UA_TA,Key_set_TA_UA,SND1,RCV1)
end role

role session3(UA:agent,TA:agent,UB:agent,Key_set_TA_UA:(symmetric_key) set,Key_set_UA_TA:(symmetric_key) set,Key_set_UB_TA:(symmetric_key) set,Key_set_TA_UB:(symmetric_key) set)
def=
	local
		SND3,RCV3,SND2,RCV2,SND1,RCV1:channel(dy)
	composition
		role_UB(UA,TA,UB,Key_set_UB_TA,Key_set_TA_UB,SND3,RCV3) /\ role_TA(UA,TA,UB,Key_set_UA_TA,Key_set_TA_UA,Key_set_UB_TA,Key_set_TA_UB,SND2,RCV2) /\ role_UA(UA,TA,UB,Key_set_UA_TA,Key_set_TA_UA,SND1,RCV1)
end role

role environment()
def=
	const
		userA:agent,hash_0:hash_func,userB:agent,authority:agent,sec_1:protocol_id,sec_2:protocol_id,auth_3:protocol_id,auth_4:protocol_id
	intruder_knowledge = {userA,authority,userB}
	composition
		session3(userA,authority,i,{},{},{},{}) /\ session2(i,authority,userB,{},{},{},{}) /\ session1(userA,authority,userB,{},{},{},{})
end role

goal
	secrecy_of sec_1
	secrecy_of sec_2
	authentication_on auth_3
	authentication_on auth_4
end goal

environment()
